---
import ArrowCardButton from "@components/ArrowCardButton.astro";
import RootPageIndex from "@components/RootPageIndex.astro";

import { CONTACT } from "@consts";
import { resolvePath } from "@lib/utils";

const linkedInContact = CONTACT.find((contact) => contact.type === "LinkedIn");
const GithubContact = CONTACT.find((contact) => contact.type === "GitHub");
---

<RootPageIndex title="Hire me (please)" searchable>
  <div class="animate mb-4">
    <p class="mb-1">My Resume (PDF):</p>
    <section>
      <ArrowCardButton
        href={resolvePath("/hire-me/Brian_Soh_Resume.pdf", Astro.url.pathname)}
        text="Download PDF"
        openInNewTab
      />
    </section>
  </div>
  <!-- <div class="animate mb-4">
    <p class="mb-1">The TXT resume:</p>
    <section>
      <ArrowCardButton
        href={resolvePath("/hire-me/milidev_resume.txt", Astro.url.pathname)}
        text="Download TXT"
        openInNewTab
      />
    </section>
  </div> -->
  {
    GithubContact && (
    <div class="animate mb-4">
      <p class="mb-1">My Github:</p>
      <section>
        <ArrowCardButton
          href={GithubContact.href}
          text="Navigate to Github"
          openInNewTab
        />
      </section>
    </div>
    )
  }

  {
    linkedInContact && (
      <div class="animate mb-4">
        <p class="mb-1">Or you can check my LinkedIn profile:</p>
        <section>
          <ArrowCardButton
            href={linkedInContact.href}
            text="Navigate to LinkedIn"
            openInNewTab
          />
        </section>
      </div>
    )
  }
</RootPageIndex>
